# 复制为 .env 并按需修改。所有变量均可通过环境变量覆盖配置文件。

# 默认栈（无需 GPU，开箱即跑）
AETHER_EMBEDDING_BACKEND=tfidf
AETHER_VECTORSTORE_BACKEND=memory
AETHER_LLM_BACKEND=mock

# 接入世界顶级后端示例（需先 pip install -e ".[world-class]"）：
# AETHER_EMBEDDING_BACKEND=sentence_transformer
# AETHER_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# AETHER_VECTORSTORE_BACKEND=chroma
# AETHER_LLM_BACKEND=openai_compatible
# AETHER_LLM_BASE_URL=http://localhost:11434/v1
# AETHER_LLM_MODEL=qwen2.5:7b
# AETHER_LLM_API_KEY=

AETHER_TOP_K=5
AETHER_SERVER_PORT=8000
